{
  "name": "couchplay",
  "version": "0.1.0",
  "private": true,
  "description": "Stream your game to friends in a Discord voice channel and pass the controller around.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "smoke": "node scripts/smoke-test.js",
    "e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
